class ChebConv:
    """Chebyshev Spectral Graph Convolutional layer (Defferrard et al., NeurIPS 2016).
    
    Approximates spectral graph convolutions using truncated Chebyshev polynomials up to order K:
        Z^{(0)} = X
        Z^{(1)} = \\tilde{L} X
        Z^{(k)} = 2 \\tilde{L} Z^{(k-1)} - Z^{(k-2)}
        out = \\sum_{k=0}^{K-1} Z^{(k)} W^{(k)} + b
    where \\tilde{L} = \\frac{2}{\\lambda_{\\max}} L - I_N is the scaled and normalized graph Laplacian.
    Executed in O(E) sparse operations."""
    def __init__(self, in_features: int, out_features: int, K: int = 3, normalization: str | None = 'sym', bias: bool = True) -> None: ...
    def forward(self, x: Tensor, edge_index: Any, lambda_max: float = 2.0) -> Tensor: ...

