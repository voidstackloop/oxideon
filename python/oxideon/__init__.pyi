class Module:
    """Base class for all neural network modules in Oxideon.
    
    Models should inherit from this class and override `forward()`.
    Submodules and parameters assigned as attributes are automatically discovered
    and registered for optimizer tracking.
    
    Example:
    ```python
    import oxideon as ox
    import oxideon.nn as nn
    
    class MLPClassifier(nn.Module):
        def __init__(self, in_features, hidden, out_features):
            super().__init__()
            self.fc1 = nn.Linear(in_features, hidden)
            self.fc2 = nn.Linear(hidden, out_features)
    
        def forward(self, x):
            return self.fc2(self.fc1(x).relu())
    
    model = MLPClassifier(784, 128, 10)
    optimizer = ox.optim.Adam(model.parameters(), lr=1e-3)
    out = model(x)
    ```"""
    def __init__(self) -> None: ...
    def __call__(self, *args: Any, **kwargs: Any) -> Any: ...
    def __repr__(self) -> str: ...
    @staticmethod
    def _copy_state_value(target: Any, val: Any, key: Any, owner_name: Any) -> Any: ...
    @staticmethod
    def _move_in_place(tensor: Any, device: Any, dtype: Any) -> Any: ...
    def _resolve_key(self, key: Any) -> Any: ...
    def add_module(self, name: str, module: Any) -> None: ...
    def apply(self, fn: Any) -> Any: ...
    def buffers(self, recurse: Any = True) -> Any: ...
    def children(self) -> Any: ...
    def cpu(self) -> Any: ...
    def cuda(self) -> Any: ...
    def eval(self) -> Any: ...
    def forward(self, *args: Any, **kwargs: Any) -> Any: ...
    def freeze(self) -> Any: ...
    def gpu(self) -> Any: ...
    def load(self, path: Any, strict: Any = True, device: Any = None) -> Any: ...
    def load_file(self, path: Any, strict: Any = True, device: Any = None) -> Any: ...
    def load_state_dict(self, state_dict: Any, strict: Any = True) -> Any: ...
    def modules(self) -> Any: ...
    def named_buffers(self, prefix: Any = '', recurse: Any = True) -> Any: ...
    def named_children(self) -> Any: ...
    def named_modules(self, memo: Any = None, prefix: Any = '') -> Any: ...
    def named_parameters(self, prefix: Any = '', recurse: Any = True) -> Any: ...
    def parameters(self, recurse: Any = True) -> Any: ...
    def register_buffer(self, name: Any, tensor: Any, persistent: Any = True) -> Any: ...
    def register_forward_hook(self, hook: Any) -> Any: ...
    def register_forward_pre_hook(self, hook: Any) -> Any: ...
    def register_parameter(self, name: Any, param: Any) -> Any: ...
    def save(self, path: Any, metadata: Any = None) -> Any: ...
    def save_file(self, path: Any, metadata: Any = None) -> Any: ...
    def state_dict(self, destination: Any = None, prefix: Any = '') -> Any: ...
    def to(self, device: Any = None, dtype: Any = None) -> Any: ...
    def train(self, mode: Any = True) -> Any: ...
    def unfreeze(self) -> Any: ...
    def zero_grad(self, set_to_none: Any = False) -> Any: ...

